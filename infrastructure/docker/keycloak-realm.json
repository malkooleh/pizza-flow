{
  "id": "pizza-flow",
  "realm": "pizza-flow",
  "enabled": true,
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "clients": [
    {
      "clientId": "pizza-flow-web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "*"
      ],
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": true
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER"
      },
      {
        "name": "ADMIN"
      }
    ]
  }
}
